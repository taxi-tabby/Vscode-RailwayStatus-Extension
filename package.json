{
  "name": "railway-status",
  "displayName": "Railway Status",
  "description": "View Railway.com deployment statuses directly in VS Code",
  "version": "0.4.0",
  "publisher": "taxi-tabby",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["railway", "deployment", "status", "cloud", "devops"],
  "repository": {
    "type": "git",
    "url": "https://github.com/taxi-tabby/Vscode-RailwayStatus-Extension"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "railway",
          "title": "Railway",
          "icon": "resources/railway.svg"
        }
      ]
    },
    "views": {
      "railway": [
        {
          "id": "railwayStatus",
          "name": "Status"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "railwayStatus",
        "contents": "Railway에 로그인하여 프로젝트를 확인하세요.\n[Railway로 로그인](command:railway.login)\n[API 토큰 사용](command:railway.loginWithToken)\n\n토큰은 [railway.com/account/tokens](https://railway.com/account/tokens) 에서 발급하세요.",
        "when": "!railway.authenticated"
      }
    ],
    "commands": [
      {
        "command": "railway.login",
        "title": "Sign in with Railway",
        "category": "Railway"
      },
      {
        "command": "railway.loginWithToken",
        "title": "Set API Token",
        "category": "Railway"
      },
      {
        "command": "railway.refresh",
        "title": "Refresh",
        "category": "Railway",
        "icon": "$(refresh)"
      },
      {
        "command": "railway.openInBrowser",
        "title": "Open in Browser",
        "category": "Railway",
        "icon": "$(link-external)"
      },
      {
        "command": "railway.copyUrl",
        "title": "Copy Service URL",
        "category": "Railway",
        "icon": "$(copy)"
      },
      {
        "command": "railway.sortBy",
        "title": "Sort By...",
        "category": "Railway",
        "icon": "$(list-ordered)"
      },
      {
        "command": "railway.enableAutoRefresh",
        "title": "Enable Auto Refresh",
        "category": "Railway",
        "icon": "$(play)"
      },
      {
        "command": "railway.disableAutoRefresh",
        "title": "Pause Auto Refresh",
        "category": "Railway",
        "icon": "$(debug-pause)"
      },
      {
        "command": "railway.logout",
        "title": "Sign Out",
        "category": "Railway"
      },
      {
        "command": "railway.redeploy",
        "title": "Redeploy",
        "category": "Railway",
        "icon": "$(debug-restart)"
      },
      {
        "command": "railway.restart",
        "title": "Restart",
        "category": "Railway",
        "icon": "$(refresh)"
      },
      {
        "command": "railway.serviceDetail",
        "title": "View Service Details",
        "category": "Railway",
        "icon": "$(info)"
      },
      {
        "command": "railway.viewVariables",
        "title": "View Variables",
        "category": "Railway",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "railway.exportEnv",
        "title": "Export .env File",
        "category": "Railway",
        "icon": "$(export)"
      },
      {
        "command": "railway.linkProject",
        "title": "Link to Workspace",
        "category": "Railway",
        "icon": "$(pin)"
      },
      {
        "command": "railway.unlinkProject",
        "title": "Unlink Project",
        "category": "Railway",
        "icon": "$(pinned-dirty)"
      },
      {
        "command": "railway.viewLogs",
        "title": "View Logs",
        "category": "Railway",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "railway.enableAutoRefresh",
          "when": "view == railwayStatus && railway.authenticated && !railway.autoRefreshEnabled",
          "group": "navigation"
        },
        {
          "command": "railway.disableAutoRefresh",
          "when": "view == railwayStatus && railway.authenticated && railway.autoRefreshEnabled",
          "group": "navigation"
        },
        {
          "command": "railway.sortBy",
          "when": "view == railwayStatus && railway.authenticated",
          "group": "navigation"
        },
        {
          "command": "railway.refresh",
          "when": "view == railwayStatus && railway.authenticated",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "railway.redeploy",
          "when": "viewItem == railwayService",
          "group": "inline@1"
        },
        {
          "command": "railway.viewLogs",
          "when": "viewItem == railwayService",
          "group": "inline@2"
        },
        {
          "command": "railway.openInBrowser",
          "when": "viewItem == railwayService",
          "group": "inline@3"
        },
        {
          "command": "railway.restart",
          "when": "viewItem == railwayService",
          "group": "1_actions@1"
        },
        {
          "command": "railway.viewVariables",
          "when": "viewItem == railwayService",
          "group": "1_actions@2"
        },
        {
          "command": "railway.exportEnv",
          "when": "viewItem == railwayService",
          "group": "1_actions@3"
        },
        {
          "command": "railway.copyUrl",
          "when": "viewItem == railwayService",
          "group": "2_copy"
        },
        {
          "command": "railway.openInBrowser",
          "when": "viewItem == railwayProject || viewItem == railwayProjectLinked",
          "group": "inline"
        },
        {
          "command": "railway.linkProject",
          "when": "viewItem == railwayProject",
          "group": "3_link"
        },
        {
          "command": "railway.unlinkProject",
          "when": "viewItem == railwayProjectLinked",
          "group": "3_link"
        }
      ]
    },
    "authentication": [
      {
        "id": "railway",
        "label": "Railway"
      }
    ],
    "configuration": {
      "title": "Railway Status",
      "properties": {
        "railway.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh deployment statuses for expanded projects."
        },
        "railway.autoRefreshActiveInterval": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "Polling interval (seconds) when active deployments are detected."
        },
        "railway.autoRefreshIdleInterval": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "description": "Polling interval (seconds) when all deployments are stable."
        },
        "railway.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when deployment status changes (success, failure, crash)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
